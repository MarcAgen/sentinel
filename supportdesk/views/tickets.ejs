<%- include('layout', { title: 'Support Tickets', user }) %>

<div class="row mb-3 align-items-center">
  <div class="col">
    <h5 class="fw-bold mb-0">Support Tickets</h5>
  </div>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <form method="POST" action="/tickets/search" class="d-flex gap-2">
      <input type="text" name="search" class="form-control" placeholder="Search tickets..." value="<%= search %>">
      <button type="submit" class="btn btn-primary px-4">Search</button>
      <% if (search) { %>
      <a href="/tickets" class="btn btn-outline-secondary">Reset</a>
      <% } %>
    </form>
  </div>
</div>

<div class="btn-group mb-3">
  <a href="/tickets" class="btn btn-sm <%= !viewMine ? 'btn-primary' : 'btn-outline-primary' %>">All Tickets</a>
  <a href="/tickets?view=mine" class="btn btn-sm <%= viewMine ? 'btn-primary' : 'btn-outline-primary' %>">My Tickets</a>
</div>

<form method="GET" action="/tickets" class="d-flex gap-2 mb-3 align-items-end flex-wrap">
  <input type="hidden" name="view" value="<%= viewMine ? 'mine' : '' %>">
  <div>
    <label class="form-label small mb-1">Status</label>
    <select name="status" class="form-select form-select-sm">
      <option value="">All</option>
      <option value="open" <%= filters && filters.status === 'open' ? 'selected' : '' %>>Open</option>
      <option value="in_progress" <%= filters && filters.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
      <option value="resolved" <%= filters && filters.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
      <option value="closed" <%= filters && filters.status === 'closed' ? 'selected' : '' %>>Closed</option>
    </select>
  </div>
  <div>
    <label class="form-label small mb-1">Priority</label>
    <select name="priority" class="form-select form-select-sm">
      <option value="">All</option>
      <option value="urgent" <%= filters && filters.priority === 'urgent' ? 'selected' : '' %>>Urgent</option>
      <option value="high" <%= filters && filters.priority === 'high' ? 'selected' : '' %>>High</option>
      <option value="medium" <%= filters && filters.priority === 'medium' ? 'selected' : '' %>>Medium</option>
      <option value="low" <%= filters && filters.priority === 'low' ? 'selected' : '' %>>Low</option>
    </select>
  </div>
  <button type="submit" class="btn btn-sm btn-primary">Filter</button>
  <a href="/tickets" class="btn btn-sm btn-outline-secondary">Reset</a>
</form>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th class="ps-3">#</th>
          <th>
            <a href="/tickets?sort=title&dir=<%= filters && filters.sort === 'title' && filters.dir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none text-dark">
              Title<% if (filters && filters.sort === 'title') { %> <%= filters.dir === 'ASC' ? '↑' : '↓' %><% } %>
            </a>
          </th>
          <th>
            <a href="/tickets?sort=priority&dir=<%= filters && filters.sort === 'priority' && filters.dir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none text-dark">
              Priority<% if (filters && filters.sort === 'priority') { %> <%= filters.dir === 'ASC' ? '↑' : '↓' %><% } %>
            </a>
          </th>
          <th>
            <a href="/tickets?sort=status&dir=<%= filters && filters.sort === 'status' && filters.dir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none text-dark">
              Status<% if (filters && filters.sort === 'status') { %> <%= filters.dir === 'ASC' ? '↑' : '↓' %><% } %>
            </a>
          </th>
          <th>Created by</th>
          <th>
            <a href="/tickets?sort=created_at&dir=<%= filters && filters.sort === 'created_at' && filters.dir === 'ASC' ? 'desc' : 'asc' %>" class="text-decoration-none text-dark">
              Date<% if (filters && filters.sort === 'created_at') { %> <%= filters.dir === 'ASC' ? '↑' : '↓' %><% } %>
            </a>
          </th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (tickets.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted py-4">No tickets found.</td></tr>
        <% } %>
        <% for (const t of tickets) { %>
        <tr>
          <td class="ps-3 text-muted small"><%= t.id %></td>
          <td><a href="/tickets/<%= t.id %>" class="text-decoration-none fw-semibold"><%= t.title %></a></td>
          <td><span class="badge badge-<%= t.priority %>"><%= t.priority %></span></td>
          <td><span class="badge bg-secondary"><%= t.status %></span></td>
          <td class="text-muted small"><%- t.creator_display_name || t.creator_name || '-' %></td>
          <td class="text-muted small"><%= t.created_at ? t.created_at.slice(0, 10) : '-' %></td>
          <td><a href="/tickets/<%= t.id %>/export" class="btn btn-outline-secondary btn-sm py-0">Export</a></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

  </div>
  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
