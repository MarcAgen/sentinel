<%- include('layout', { title: 'Login', user: null }) %>

<div class="row justify-content-center">
  <div class="col-md-4">
    <div class="card shadow-sm mt-5">
      <div class="card-body p-4">
        <h4 class="card-title mb-4 text-center fw-bold">SupportDesk</h4>
        <p class="text-muted text-center small mb-4">TechCo internal helpdesk portal</p>

        <% if (error) { %>
        <div class="alert alert-danger py-2 small">Invalid credentials. Please try again.</div>
        <% } %>

        <form method="POST" action="/login">
          <div class="mb-3">
            <label class="form-label">Email address</label>
            <input type="email" name="email" class="form-control" placeholder="firstname.lastname@techco.local" required>
          </div>
          <div class="mb-4">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
      </div>
    </div>
  </div>
</div>

  </div>
  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
