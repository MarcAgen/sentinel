<%- include('layout', { title: 'Administration', user }) %>

<div class="row mb-3">
  <div class="col">
    <h5 class="fw-bold mb-0">Administration</h5>
    <p class="text-muted small">Management and system diagnostics</p>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold">Users</div>
      <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">ID</th>
              <th>Username</th>
              <th>Email</th>
              <th>Role</th>
            </tr>
          </thead>
          <tbody>
            <% for (const u of users) { %>
            <tr>
              <td class="ps-3 text-muted small"><%= u.id %></td>
              <td><%= u.username %></td>
              <td class="text-muted small"><%= u.email %></td>
              <td><span class="badge <%= u.role === 'admin' ? 'bg-danger' : 'bg-secondary' %>"><%= u.role %></span></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white fw-semibold">Network diagnostics</div>
      <div class="card-body">
        <p class="text-muted small mb-3">Check the availability of a remote resource.</p>
        <form method="POST" action="/admin/fetch">
          <div class="mb-3">
            <label class="form-label small fw-semibold">URL to test</label>
            <input type="text" name="url" class="form-control" placeholder="https://..." value="<%= fetchUrl %>">
          </div>
          <button type="submit" class="btn btn-primary btn-sm">Test</button>
        </form>

        <% if (result !== null) { %>
        <div class="mt-3">
          <label class="form-label small fw-semibold">Response</label>
          <pre class="bg-light border rounded p-3 small" style="max-height:300px;overflow:auto"><%= result %></pre>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

  </div>
  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
